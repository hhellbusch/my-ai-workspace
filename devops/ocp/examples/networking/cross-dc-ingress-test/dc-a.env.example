# Copy to dc-a.env (gitignored) or render from inventory:
#   cd ../cross-dc-rollout && python3 render-config.py --inventory inventory-dc-a.yaml

export DCA_KUBECONFIG="${HOME}/.kube/dc-a.kubeconfig"

# Repl-gateway nodes (must run replication IngressController)
export DCA_NODE_NAMES="worker-0.dc-a.example.com worker-1.dc-a.example.com"
export DCA_BOND_VLAN_IFACE="bond-repl.200"
export DCA_LOCAL_SUBNET="10.200.1.0/26"
export DCA_REMOTE_SUBNET="10.200.2.0/26"
export DCA_EXPECTED_MTU="1500"

# Ingress shard (must match ingresscontroller.example.yaml)
export DCA_INGRESS_CONTROLLER_NAME="replication"
export DCA_INGRESS_DOMAIN="kafka-repl.dc-a.example.com"
export DCA_INGRESS_ROUTE_LABEL_KEY="ingress"
export DCA_INGRESS_ROUTE_LABEL_VALUE="replication"

# Frontend on replication VLAN — vip or space-separated node repl IPs (dns_lb)
export DCA_FRONTEND_MODE="vip"
export DCA_FRONTEND_TARGETS="10.200.1.5"

export DCA_INGRESS_EXTERNAL_PORT="443"
export DCA_TEST_ROUTE_HOST="repl-test.kafka-repl.dc-a.example.com"

# Echo backend image (same as cross-dc-network-test)
export TEST_PROBE_IMAGE="quay.io/rh_hhellbusch/repl-net-probe:0.1.1"
