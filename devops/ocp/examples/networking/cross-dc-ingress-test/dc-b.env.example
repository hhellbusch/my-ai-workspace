# Copy to dc-b.env (gitignored) or render from inventory-dc-b.yaml

export DCB_KUBECONFIG="${HOME}/.kube/dc-b.kubeconfig"
export DCB_NODE_NAMES="worker-0.dc-b.example.com worker-1.dc-b.example.com"
export DCB_BOND_VLAN_IFACE="bond-repl.200"
export DCB_LOCAL_SUBNET="10.200.2.0/26"
export DCB_REMOTE_SUBNET="10.200.1.0/26"
export DCB_EXPECTED_MTU="1500"

export DCB_INGRESS_CONTROLLER_NAME="replication"
export DCB_INGRESS_DOMAIN="kafka-repl.dc-b.example.com"
export DCB_INGRESS_ROUTE_LABEL_KEY="ingress"
export DCB_INGRESS_ROUTE_LABEL_VALUE="replication"

export DCB_FRONTEND_MODE="vip"
export DCB_FRONTEND_TARGETS="10.200.2.5"

export DCB_INGRESS_EXTERNAL_PORT="443"
export DCB_TEST_ROUTE_HOST="repl-test.kafka-repl.dc-b.example.com"

export TEST_PROBE_IMAGE="quay.io/rh_hhellbusch/repl-net-probe:0.1.1"
