# Copy to dc-b.env (untracked) OR render from inventory:
#   cd ../cross-dc-rollout && python3 render-config.py --inventory inventory-dc-b.yaml
# Variables are prefixed DCB_ to avoid collision when both env files are sourced together.

export DCB_KUBECONFIG="${HOME}/.kube/dc-b.kubeconfig"

# Nodes carrying the replication bond/VLAN in this DC — space-separated.
# Confirm with: oc get nodes -l node-role.kubernetes.io/repl-gateway -o name
export DCB_NODE_NAMES="worker-0.dc-b.example.com worker-1.dc-b.example.com"

# Must match the VLAN interface name from the NNCP applied to DCB_NODE_NAMES.
export DCB_BOND_VLAN_IFACE="bond-repl.200"

# This DC's replication subnet gateway and the *other* DC's subnet — same
# values as the NNCP's routes.config in cross-dc-nncp-helm, not the NAD's
# own pool (see cross-dc-replication.md#layer-3-routing).
export DCB_LOCAL_GATEWAY="10.200.2.1"
export DCB_REMOTE_SUBNET="10.200.1.0/26"

# Test-only whereabouts pool: a small range carved out of this DC's /26 that
# does NOT overlap the real Kafka pool or host IPs. Adjust if your real
# inventory uses these addresses for something else.
export DCB_TEST_POOL_RANGE="10.200.2.0/26"
export DCB_TEST_POOL_START="10.200.2.6"
export DCB_TEST_POOL_END="10.200.2.10"

# Expected MTU on the replication path, for the test 5 sweep to compare
# against. 1500 = standard Ethernet; raise only if the WAN circuit is
# confirmed to carry jumbo frames end-to-end.
export DCB_EXPECTED_MTU="1500"

# UBI9 probe image built from repl-net-probe/Containerfile — must be pullable
# from both clusters. Same value in dc-a.env.
export TEST_PROBE_IMAGE="quay.io/rh_hhellbusch/repl-net-probe:0.1.1"
